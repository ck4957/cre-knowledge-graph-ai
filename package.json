{
  "name": "cre-knowledge-graph-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ai:evaluate": "tsx scripts/evaluate-graphrag.ts local",
    "ai:evaluate:http": "tsx scripts/evaluate-graphrag.ts http",
    "db:migrate": "tsx scripts/run-migrations.ts run",
    "db:revert": "tsx scripts/run-migrations.ts revert",
    "db:seed": "npm run db:migrate && tsx scripts/seed-postgres.ts && tsx scripts/seed-neo4j.ts",
    "db:seed:postgres": "npm run db:migrate && tsx scripts/seed-postgres.ts",
    "db:seed:neo4j": "tsx scripts/seed-neo4j.ts",
    "stack:verify": "bash scripts/verify-local-stack.sh"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "neo4j-driver": "^5.28.0",
    "next": "^16.2.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
