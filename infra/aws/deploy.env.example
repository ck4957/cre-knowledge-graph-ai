AWS_REGION=us-east-1

# Optional when Terraform output ecr_repository_url is unavailable.
ECR_REPOSITORY_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com/cre-knowledge-graph-ai

# Defaults to the current git SHA when omitted.
IMAGE_TAG=latest

# Used by npm run aws:seed. These subnets must reach RDS and the graph endpoint.
AWS_SEED_SUBNET_IDS=subnet-public-a,subnet-public-b
AWS_ASSIGN_PUBLIC_IP=ENABLED

# Optional when Terraform output app_url is unavailable.
APP_URL=http://example-alb.us-east-1.elb.amazonaws.com

# Optional managed embedding provider settings.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_API_URL=https://embeddings.example.com/v1/embeddings
EMBEDDING_MODEL=managed-embedding-model
EMBEDDING_RESPONSE_PATH=data.0.embedding
